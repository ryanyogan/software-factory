{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "db:migrate:local": "pnpm --filter @sf/api db:migrate:local",
    "dev": "pnpm --filter @sf/web dev",
    "sf": "node apps/cli/dist/cli.mjs",
    "gate": "bash scripts/gate.sh",
    "perf": "node scripts/perf-budget.mjs",
    "db:reset:local": "rm -rf apps/api/.wrangler/state && pnpm db:migrate:local",
    "gate:local": "bash scripts/gate-local.sh"
  },
  "devDependencies": {
    "@sf/config": "workspace:*",
    "@tanstack/intent": "^0.5.5",
    "@types/node": "^24.19.2",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@11.17.0",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
